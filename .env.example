# Copy to `.env` (never commit `.env`). Real environment variables override this file.

# --- Providers ---
# LLM provider: fake (offline) | gemini
DOC_AGENT_LLM_PROVIDER=fake
DOC_AGENT_LLM_MODEL=
# Embedding provider: fake (offline) | gemini. Changing the embedding model requires re-ingesting.
DOC_AGENT_EMBEDDING_PROVIDER=fake
DOC_AGENT_EMBEDDING_MODEL=
# Vector store: memory | chroma
DOC_AGENT_VECTOR_STORE=memory
DOC_AGENT_PERSIST_DIR=.doc_agent_data
# Conversation memory (SQLite). Empty means <DOC_AGENT_PERSIST_DIR>/checkpoints.sqlite.
DOC_AGENT_CHECKPOINT_DB=

# --- Tuning ---
DOC_AGENT_MAX_UPLOAD_MB=20
DOC_AGENT_CHUNK_SIZE=500
DOC_AGENT_CHUNK_OVERLAP=50
DOC_AGENT_RETRIEVAL_K=4
# Summarization: parallel LLM calls (keep low on the free Gemini tier) and summaries merged per call.
DOC_AGENT_SUMMARIZE_WORKERS=2
DOC_AGENT_SUMMARIZE_GROUP_SIZE=8
# Follow-up questions: recent messages used to rewrite "how long are they?" into a standalone question.
# A follow-up turn costs one extra LLM call; first turns cost none. 0 turns the rewrite off.
DOC_AGENT_REWRITE_HISTORY_TURNS=4

# --- Reliability ---
DOC_AGENT_LLM_TIMEOUT_S=60
# Total wall-clock budget per API chat request, including every LLM call and retry.
DOC_AGENT_CHAT_TIMEOUT_S=120
DOC_AGENT_SUMMARIZE_TIMEOUT_S=600
# UI mode: http (connect to the API) | embedded (run DocAgentApp in this process).
DOC_AGENT_MODE=http
DOC_AGENT_API_URL=http://127.0.0.1:8000
# Must be longer than DOC_AGENT_SUMMARIZE_TIMEOUT_S. Default: max(660, summarize timeout + 60).
DOC_AGENT_UI_TIMEOUT_S=660
# Any HTTP UI client must allow more than the server-side summarize budget.
# Retries per LLM/embedding call for rate limits (429) and temporary server errors (500/502/503/504).
# A call makes at most this many + 1 attempts. A 429 waits for the delay the server asks for (at most
# 60 s per wait), other errors use exponential backoff (1 s, 2 s, 4 s, ... also capped at 60 s), both
# with a little jitter. Authentication and other client errors are never retried. The default is enough
# to summarize a long document on the 15-requests-per-minute free Gemini tier.
DOC_AGENT_LLM_MAX_RETRIES=8

# --- Secret keys (placeholders only; read by the provider adapters) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- LangSmith tracing (off by default; enabling it sends prompts and document text to LangSmith) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=doc-agent

# --- Real-provider tests (optional) ---
# DOC_AGENT_RUN_REAL=1
